# ==========================================
# MongoDB
# ==========================================

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority


# ==========================================
# Groq
# ==========================================

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant


# ==========================================
# LiteLLM
# ==========================================

LITELLM_URL=https://your-litellm-service.onrender.com

LITELLM_KEY=your_litellm_master_key

CHAT_MODEL=Qwen/Qwen2.5-3B-Instruct
GEMINI_API_KEY=your_existing_gemini_key
GEMINI_MODEL=gemini-3.1-flash-lite


# ==========================================
# Admin
# ==========================================

ADMIN_API_KEY=change_this_to_a_long_random_key


# ==========================================
# Frontend CORS
# ==========================================

CORS_ORIGINS=https://your-frontend.vercel.app


# ==========================================
# Websites to crawl
# ==========================================

SITE_URL=https://your-voiceng-site.com

FIA_URL=https://www.fia.gov.pk


# ==========================================
# Langfuse
# ==========================================

LANGFUSE_PUBLIC_KEY=pk_xxxxxxxxx

LANGFUSE_SECRET_KEY=sk_xxxxxxxxx

LANGFUSE_HOST=https://cloud.langfuse.com


# ==========================================
# LiteLLM / Hugging Face
# ==========================================

HF_TOKEN=hf_xxxxxxxxx

LITELLM_MASTER_KEY=sk-xxxxxxxxx
